# Copy to .env.local for local runs. On Vercel, add these under Project Settings > Environment Variables.

# Password you type to get into the app
APP_PASSWORD=

# Anthropic API key (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Optional: which model to use (defaults to claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Notion internal integration secret (notion.so/profile/integrations)
NOTION_TOKEN=
# Database IDs from the Student Planner (defaults are filled in for Aaron's workspace)
NOTION_COURSES_DB=3b961d004d7080779e4cce9f9c770057
NOTION_ASSIGNMENTS_DB=26261d004d7081e3ade1c25fb0f79ac4

# Brightspace calendar feed (Calendar > Subscribe > All Calendars and Tasks). Keep private.
BRIGHTSPACE_ICS_URL=

# ---- Student sign-ups (see README "Student sign-ups") ----
# open = any school email gets a code right away
# approval = students request, you approve on /admin
# closed = no new sign-ups (invite codes still work)
SIGNUP_MODE=open
# Which emails count as school emails (subdomains like zips.uakron.edu count too)
ALLOWED_EMAIL_DOMAINS=uakron.edu
# Uploads per student per semester
STUDENT_RUN_LIMIT=5
# Most new students per day, to protect your API bill
SIGNUP_DAILY_CAP=100
# Your guess at AI cost per upload, for the /admin estimate (check console.anthropic.com)
COST_PER_RUN=0.10

# Supabase secret key (Project Settings > API Keys > Secret keys). Server only, never share.
SUPABASE_SECRET_KEY=

# Email for sending codes. Gmail: turn on 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: shown as the sender, e.g. Syllabus Planner <syllabusplanner@gmail.com>
EMAIL_FROM=
# Where students reply for help, and where "someone asked for access" alerts go
CONTACT_EMAIL=
# The site's address, used in the sign-in link inside the email
APP_URL=https://syllabus-planner-nine.vercel.app
